<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F10"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="@drawable/badge_bg"
        android:textColor="#0F0F10"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:text="CHECK-IN ALARM" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="#F7F4EB"
        android:textSize="64sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.02"
        android:text="09:00" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#CCF7F4EB"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:text="It is time to check in! Choose Check-in or Leave below." />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/primary_btn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#F7F4EB"
        android:textColor="#0F0F10"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:text="CHECK-IN (OPEN PORTAL)" />

    <Button
        android:id="@+id/secondary_btn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        android:textColor="#F7F4EB"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:text="APPLY FOR LEAVE" />

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
