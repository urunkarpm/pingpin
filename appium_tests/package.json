{
  "name": "pingpin-appium-tests",
  "version": "1.0.0",
  "description": "Appium alarm tests for PingPin Flutter app",
  "scripts": {
    "test": "npx wdio run wdio.conf.js",
    "test:alarm": "npx wdio run wdio.conf.js --spec tests/alarm.test.js",
    "test:checkin": "npx wdio run wdio.conf.js --spec tests/checkin_alarm.test.js",
    "test:checkout": "npx wdio run wdio.conf.js --spec tests/checkout_alarm.test.js",
    "test:settings": "npx wdio run wdio.conf.js --spec tests/alarm_settings.test.js"
  },
  "dependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "webdriverio": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
