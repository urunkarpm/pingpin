<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_expanded_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#161822">

    <!-- Header Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:background="@drawable/notification_primary_btn_bg" />

        <TextView
            android:id="@+id/notif_expanded_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="PINGPIN • ATTENDANCE REMINDER"
            android:textColor="#A0AEC0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/notif_expanded_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW"
            android:textColor="#718096"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Banner Title & Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/notif_expanded_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_stat_notification"
            android:contentDescription="Notification Icon"
            android:background="@drawable/notification_primary_btn_bg"
            android:padding="9dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time for Attendance!"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_expanded_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Don't forget to mark your daily attendance on the office HR portal."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/notif_expanded_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tap 'Open Portal' to launch directly or 'Snooze' for 10 min."
                android:textColor="#818CF8"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/notif_expanded_actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_notif_expanded_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/notification_secondary_btn_bg"
            android:text="Dismiss"
            android:textColor="#A0AEC0"
            android:textSize="13sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btn_notif_expanded_snooze"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/notification_secondary_btn_bg"
            android:text="Snooze 10m"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btn_notif_expanded_open"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/notification_primary_btn_bg"
            android:text="Open HR Portal"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

</LinearLayout>
